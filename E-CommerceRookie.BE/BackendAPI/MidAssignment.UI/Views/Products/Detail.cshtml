@using Microsoft.Extensions.Options
@using MidAssignment.UI.Services
@model MidAssignment.UI.Models.ProductDetailViewModel
@inject IOptions<ApiSettings> ApiSettings
@{
    ViewData["Title"] = "Product Detail";
    var baseUrl = ApiSettings.Value.BaseUrl?.TrimEnd('/') ?? string.Empty;
    string BuildImageUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return string.Empty;
        }

        if (url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            return url;
        }

        return string.IsNullOrEmpty(baseUrl) ? url : $"{baseUrl}{url}";
    }
}

<div class="shell">
    <a class="back-link" asp-controller="Products" asp-action="Index">← Back to products</a>

    <div class="detail-page">
        <div class="detail-card">
            <p class="eyebrow">@Model.Product.CategoryName</p>
            <h1 class="detail-title">@Model.Product.Name</h1>
            <p class="lead">@Model.Product.Description</p>
            <div class="price">$@Model.Product.Price</div>

            <div class="detail-meta">
                <div>Created: @Model.Product.CreatedAt.ToString("MMM dd, yyyy")</div>
                <div>Updated: @(Model.Product.UpdatedAt?.ToString("MMM dd, yyyy") ?? "-")</div>
            </div>
        </div>
        <div class="detail-card">
            <p class="eyebrow">Images</p>
            @if (Model.Product.ImageUrls?.Count > 0)
            {
                if (Model.Product.ImageUrls.Count > 1)
                {
                    var carouselId = $"productCarousel-{Model.Product.Id}";
                    <div id="@carouselId" class="carousel slide detail-carousel" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            @for (var index = 0; index < Model.Product.ImageUrls.Count; index++)
                            {
                                <button type="button" data-bs-target="#@carouselId" data-bs-slide-to="@index"
                                        class="@(index == 0 ? "active" : "")" aria-current="@(index == 0 ? "true" : "false")"
                                        aria-label="Slide @(index + 1)"></button>
                            }
                        </div>
                        <div class="carousel-inner">
                            @for (var index = 0; index < Model.Product.ImageUrls.Count; index++)
                            {
                                var imageUrl = BuildImageUrl(Model.Product.ImageUrls[index]);
                                <div class="carousel-item @(index == 0 ? "active" : "")">
                                    <img src="@imageUrl" class="d-block w-100" alt="@Model.Product.Name" />
                                </div>
                            }
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                }
                else
                {
                    var imageUrl = BuildImageUrl(Model.Product.ImageUrls[0]);
                    <div class="detail-image-single">
                        <img src="@imageUrl" alt="@Model.Product.Name" />
                    </div>
                }
            }
            else
            {
                <div class="empty-state">No images available.</div>
            }
        </div>
    </div>
</div>
